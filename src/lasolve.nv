// lasolve — the one-call forms, for the caller who has one matrix and
// one right-hand side and is not going to come back.
//
// WHY THESE EXIST WHEN THE DECOMPOSITIONS ARE RIGHT THERE.  A caller
// who solves one system once should not have to know what an LU
// factorisation is, and a package that made them learn would be
// answering a design question with homework.  Every function here is
// two lines — factor, then use — and every one of them names the module
// a repeat caller should go to instead.
//
// AND WHY THEY ARE IN THEIR OWN MODULE RATHER THAN BESIDE THE
// FACTORISATIONS.  Because the convenience and the value are different
// promises, and putting them in one module hides which is which.  A
// reader who opens `lalu` sees a factorisation that is worth keeping; a
// reader who opens `lasolve` sees a page of functions that each say
// "this throws the factorisation away".  That is the whole information,
// and it is in the module boundary rather than repeated ten times.
//
// EVERY ONE OF THESE THROWS THE FACTORISATION AWAY.  Calling
// `lasolve.solve(a, b)` in a loop over fifty right-hand sides does the
// cubic work fifty times.  That is stated on each function, not because
// a reader will not have read it here, but because the function is the
// thing they will be looking at.

use ndfloat
use lafault
use lalu
use lachol
use laqr
use lasvd

// ── the shapes, which are the caller's to get wrong ─────────────────

// The extents of a square matrix, or the refusal that says why it is
// not one.
fn square_dims(a: NdFloat, what: Str) -> Result<[Int], LaFault>
    let dims = ndfloat.shape(a).dims
    if list.len(dims) != 2
        return Err(LaNotMatrix(what, list.len(dims)))
    let rows = list.get(dims, 0)
    let cols = list.get(dims, 1)
    if rows != cols
        return Err(LaNotSquare(rows, cols))
    Ok(dims[:])

// A flat list of `n` zeroes.
fn zeros(n: Int) -> [Float]
    list.map(0..n, i => 0.0)

// An array over a flat list at these dims.
fn array_of(xs: [Float], dims: [Int]) -> NdFloat
    ndfloat.of_list(xs, dims)!

// The length of a vector operand, or the refusal that says why it is
// not one of the length the matrix needs.
fn vector_of(b: NdFloat, n: Int, what: Str) -> Result<[Float], LaFault>
    let r = ndfloat.rank(b)
    if r != 1
        return Err(LaNotVector(what, r))
    let xs = ndfloat.to_list(b)
    if list.len(xs) != n
        return Err(LaDimensionMismatch(n, list.len(xs)))
    Ok(xs)

// `x` such that `A x = b`, for a square `A`.
//
// LU with partial pivoting, then forward and back substitution — the
// general-purpose solve, and the right one when nothing is known about
// the matrix.  `LaSingular` when it is.
//
// **One shot.**  A caller with several right-hand sides wants
// `lalu.factor` once and `lalu.solve` per side, at `n³/3` plus `k n²`
// rather than `k n³/3`.
//
// ```novo
// use ndfloat
// use lasolve
//
// fn main() [io]
//     match ndfloat.eye(2)
//         Ok(a) =>
//             match ndfloat.of_list([1.0, 2.0], [2])
//                 Ok(b) =>
//                     match lasolve.solve(a, b)
//                         Ok(x)  => println("${ndfloat.size(x)}")   // 2
//                         Err(e) => println(e.message())
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn solve(a: NdFloat, b: NdFloat) -> Result<NdFloat, LaFault> []
    let lu = lalu.factor(a)!
    lalu.solve(lu, b)

// `x` such that `A x = b`, for a symmetric positive-definite `A`.
//
// Cholesky, at half the work of `solve` — and `LaNotPositiveDefinite`
// when the matrix is not one, which is also the standard test for
// whether it is.  Only the lower triangle is read.
//
// **One shot.**  `lachol.factor` and `lachol.solve` for a repeat
// caller.
pub fn solve_spd(a: NdFloat, b: NdFloat) -> Result<NdFloat, LaFault> []
    let c = lachol.factor(a)!
    // `b` may be one right-hand side or several: the factor is the
    // same and the loop over sides costs the transpose's worth of
    // work, so both shapes are answered here rather than refused.
    if ndfloat.rank(b) == 2
        lachol.solve_matrix(c, b)
    else
        lachol.solve(c, b)

// `x` minimising `||A x - b||₂`, for a matrix with full column rank.
//
// Householder QR.  `LaSingular` when the columns are dependent — the
// case `lstsq_minimum_norm` answers.
//
// **One shot.**  `laqr.factor` and `laqr.lstsq` for a repeat caller,
// which is what fitting the same design matrix to fifty response
// vectors is.
pub fn lstsq(a: NdFloat, b: NdFloat) -> Result<NdFloat, LaFault> []
    let qr = laqr.factor(a)!
    laqr.lstsq(qr, b)

// The minimum-norm `x` minimising `||A x - b||₂`, for a matrix of any
// rank.
//
// The SVD path.  Slower than `lstsq` and it never refuses: a
// rank-deficient system has infinitely many least-squares solutions and
// this picks the smallest.
//
// `tolerance` is the absolute cut below which a singular value counts
// as zero; `LaBadTolerance` for a negative one.
//
// **One shot.**  `lasvd.factor` and `lasvd.lstsq` for a repeat caller.
pub fn lstsq_minimum_norm(a: NdFloat, b: NdFloat, tolerance: Float) -> Result<NdFloat, LaFault> []
    // The tolerance is checked before the factorisation: a negative one
    // is the calling code's mistake and there is no reason to pay for
    // an SVD to find out.
    if tolerance < 0.0
        return Err(LaBadTolerance(tolerance))
    let s = lasvd.factor(a)!
    lasvd.lstsq(s, b, tolerance)

// The inverse of a square matrix.
//
// LU, then `dgetri`.  The warning `lalu.inverse` carries applies in
// full and is worth repeating where a caller will actually be looking:
// **to solve a system, use `solve`.**  Forming the inverse and
// multiplying is three times the work and loses accuracy, and the only
// good reasons for an explicit inverse are that a formula needs its
// entries or that it is being displayed.
//
// `LaSingular` for a singular matrix, which is the whole of what is
// refused.
pub fn inverse(a: NdFloat) -> Result<NdFloat, LaFault> []
    let lu = lalu.factor(a)!
    lalu.inverse(lu)

// The determinant of a square matrix.
//
// LU, then the product of `U`'s diagonal with the permutation's sign.
// Overflows for a large matrix of large entries, which is inherent —
// `lalu.log_abs_determinant` is the call that does not.
pub fn determinant(a: NdFloat) -> Result<Float, LaFault> []
    let lu = lalu.factor(a)!
    Ok(lalu.determinant(lu))

// The numerical rank of a matrix.
//
// An SVD and a count.  There is no cheaper honest answer: rank is a
// question about how close the singular values get to zero, and no
// factorisation that does not compute them can say.
//
// `tolerance` is absolute; `lasvd.default_rank_tolerance` is numpy's
// rule for a caller who wants numpy's answer.
pub fn rank(a: NdFloat, tolerance: Float) -> Result<Int, LaFault> []
    if tolerance < 0.0
        return Err(LaBadTolerance(tolerance))
    let s = lasvd.factor(a)!
    lasvd.rank(s, tolerance)

// The Moore-Penrose pseudoinverse of a matrix.
//
// An SVD, reciprocal singular values above the tolerance, and the
// transpose.  **One shot**: `lasvd.factor` and `lasvd.pseudoinverse`
// for a repeat caller.
pub fn pseudoinverse(a: NdFloat, tolerance: Float) -> Result<NdFloat, LaFault> []
    if tolerance < 0.0
        return Err(LaBadTolerance(tolerance))
    let s = lasvd.factor(a)!
    lasvd.pseudoinverse(s, tolerance)

// `x` such that `L x = b`, for a lower-triangular `L`.
//
// LAPACK `dtrsv`.  Forward substitution, at `n²`, with nothing factored
// at all — the call for a caller who already HAS a triangular matrix,
// from a Cholesky factor they kept, from a sparse structure they built,
// or from a linear program's basis.
//
// Only the lower triangle is read; whatever is above it is ignored
// rather than refused.  `LaSingular` for a zero on the diagonal.
pub fn solve_lower(l: NdFloat, b: NdFloat) -> Result<NdFloat, LaFault> []
    let dims = square_dims(l, "lasolve.solve_lower")!
    let n = list.get(dims, 0)
    let rhs = vector_of(b, n, "lasolve.solve_lower")!
    let xs = ndfloat.to_list(l)
    var out = zeros(n)
    var i = 0
    while i < n
        let d = xs[i * n + i]
        // A zero on the diagonal is the one thing this can refuse:
        // there is no forward substitution past it.
        if d == 0.0
            return Err(LaSingular(i, 0.0))
        var s = rhs[i]
        for j in 0..i
            s = s - xs[i * n + j] * out[j]
        out[i] = s / d
        i = i + 1
    Ok(array_of(out, [n]))

// `x` such that `U x = b`, for an upper-triangular `U`.
//
// Back substitution.  The other half of the pair, and only the upper
// triangle is read.
pub fn solve_upper(u: NdFloat, b: NdFloat) -> Result<NdFloat, LaFault> []
    let dims = square_dims(u, "lasolve.solve_upper")!
    let n = list.get(dims, 0)
    let rhs = vector_of(b, n, "lasolve.solve_upper")!
    let xs = ndfloat.to_list(u)
    var out = zeros(n)
    var i = n - 1
    while i >= 0
        let d = xs[i * n + i]
        if d == 0.0
            return Err(LaSingular(i, 0.0))
        var s = rhs[i]
        for j in i + 1..n
            s = s - xs[i * n + j] * out[j]
        out[i] = s / d
        i = i - 1
    Ok(array_of(out, [n]))
